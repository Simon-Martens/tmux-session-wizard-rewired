#!/bin/bash

CURRENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$CURRENT_DIR/../src/helpers.sh"

# Get the current directory
if [ -n "$TMUX" ]; then
  DIR_FULL_UNESCAPED=$(tmux display-message -p "#{pane_current_path}" 2>/dev/null || echo "$HOME")
else
  DIR_FULL_UNESCAPED=$(pwd 2>/dev/null || echo "$HOME")
fi

DEFAULT_SESSION=$(basename "$DIR_FULL_UNESCAPED" | _normalize)
DIR_FULL=$(echo "$DIR_FULL_UNESCAPED" | sed -e "$TILDE_REPLACER")

SELECT_WINDOW=$(get_tmux_option "@session-wizard-windows" "off")
if [ "$SELECT_WINDOW" == "on" ]; then
  RESULT=$(tmux list-windows -a -F "#{session_last_attached} #{session_name}: #{window_name}(#{window_index})\
#{?session_grouped, (group ,}#{session_group}#{?session_grouped,),}#{?session_attached,#{?window_active, (attached),},}")
else
  RESULT=$(tmux list-sessions -F "#{session_last_attached} #{session_name}: #{session_windows} window(s)\
#{?session_grouped, (group ,}#{session_group}#{?session_grouped,),}#{?session_attached, (attached),}")
fi

# New: add current directory option, if running outside of tmux, or attaching to a session, if it exists
if [ -z "$TMUX" ]; then
  if tmux has-session -t="$DEFAULT_SESSION" 2>/dev/null; then
    RESULT=$(echo "Default: [Existing] $DEFAULT_SESSION"; echo "$RESULT")
  else
    RESULT=$(echo "Default: [New] $DEFAULT_SESSION"; echo "$RESULT")
  fi
fi

QUERY_AND_RESULT=$( (
  echo "$RESULT" |
    sort -r | (if [ -n "$TMUX" ]; then grep -v " $(tmux display-message -p '#S'):"; else cat; fi) | cut -d' ' -f2-
  zoxide query -l | sed -e "$HOME_REPLACER"
) | $(__fzfcmd) --reverse --print-query --tiebreak=index --prompt="Session> " --margin=0,0 --info=inline)

FZF_EXIT=$?
if [ $FZF_EXIT -eq 130 ]; then
  exit 0
fi

QUERY=$(echo "$QUERY_AND_RESULT" | head -n 1)
RESULT=$(echo "$QUERY_AND_RESULT" | tail -n 1)

# Current directory option was selected OR
# Nothing was entered and nothing was selected: default session
if [[ "$RESULT" == "[New]"* ]] || [[ "$RESULT" == "[Existing]"* ]] || [[ -z "$QUERY" && -z "$RESULT" ]]; then
  if ! tmux has-session -t="$DEFAULT_SESSION" 2>/dev/null; then
    tmux new-session -d -s "$DEFAULT_SESSION" -c "$DIR_FULL"
    tmux set-option -t "$DEFAULT_SESSION" @project-folder "$DIR_FULL"
  fi

  SESSION="$DEFAULT_SESSION"

# Nothing was given, name is also empty
# This case probably doesn't happen, but just in case
elif [ -z "$RESULT" ]; then
  exit 0

# Nothing found, but a query given, OR 
# :Query - create new session with that name
elif [ "$RESULT" == "$QUERY" ] || [[ "$QUERY" == :* ]]; then
  if [[ "$QUERY" == :* ]]; then
    QUERY=${QUERY:1}
  fi

  NEW_SESSION_NAME=$(echo "$QUERY" | _normalize)
  
  # Check if session already exists
  if ! tmux has-session -t="$NEW_SESSION_NAME" 2>/dev/null; then
    tmux new-session -d -s "$NEW_SESSION_NAME" -c "$DIR_FULL"
    tmux set-option -t "$NEW_SESSION_NAME" @project-folder "$DIR_FULL"
  fi

  SESSION="$NEW_SESSION_NAME"
  
# Session selected
elif [[ $RESULT == *":"* ]]; then
  SESSION=$(echo "$RESULT" | awk '{print $1}')
  SESSION=${SESSION//:/}
  if [ "$SELECT_WINDOW" == "on" ]; then
    WINDOW=$(echo "$RESULT" | awk -F"[()]" '{print $(NF-1)}')
  fi

# Path selected
else
  DIR_FULL=$(echo "$RESULT" | sed -e "$TILDE_REPLACER")
  DIR_WITH_TILDE=$(echo "$RESULT" | sed -e "$HOME_REPLACER") # in case it came from a direct usage of `t <path>`

  # Quit if directory does not exists
  if [ ! -d "$DIR_FULL" ]; then
    exit 0
  fi

  # Promote rank in zoxide.
  zoxide add "$DIR_FULL"

  SESSION=$(basename "$DIR_WITH_TILDE" | _normalize)

  if ! tmux has-session -t="$SESSION" 2>/dev/null; then
    tmux new-session -d -s "$SESSION" -c "$DIR_FULL"
  fi
fi


# Attach to session
# Escape tilde which if it appears by itself, tmux will interpret as a marked target
# https://github.com/tmux/tmux/blob/master/cmd-find.c#L1024C51-L1024C57
SESSION=$(echo "$SESSION" | sed 's/^~$/\\~/')
if [ -z "$TMUX" ]; then
  if [ -n "$SESSION_WIZARD_INTEGRATION_TEST" ]; then
    echo "Running integrtion test, so not attaching to tmux session"
  else
    tmux attach -t "$SESSION"
  fi
else
  tmux switch-client -t "$SESSION"
fi

if [ -n "$WINDOW" ]; then
  tmux select-window -t "$SESSION:$WINDOW"
fi
